# --- Web app ---------------------------------------------------------------
APP_PORT=8080
# Address of the app as people reach it (used for the link in mails)
PUBLIC_URL=http://alarm.example.local:8080
TZ=Europe/Brussels

# InfluxDB (can also be set in the app under Instellingen)
INFLUX_URL=http://influxdb:8086
INFLUX_ORG=
INFLUX_TOKEN=

# --- Asterisk ------------------------------------------------------------------
# Password between the app and Asterisk: choose a long random string.
AMI_PASSWORD=change-me-to-a-long-random-string

# SIP account at your VoIP provider (leave empty to only use the test numbers test:1001 …)
SIP_HOST=
SIP_PORT=5060
SIP_USERNAME=
SIP_PASSWORD=
# Only if the provider uses a different authentication user than SIP_USERNAME
SIP_AUTH_USERNAME=
# Number shown to the person called (often required to be one of your numbers at the provider)
CALLER_ID=

# Public IP of this server when it is behind NAT (helps with one-way audio)
EXTERNAL_IP=
RTP_START=10000
RTP_END=10100
